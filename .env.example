# =========================================================================
# Poro Guess UI - Environment Variables Example
# =========================================================================
# Copy this file to .env.local for local development.
# For production (e.g., Vercel), add these variables to your project settings.
# =========================================================================

# The URL of the Poro Guess API Backend.
# Local Development: http://localhost:3000
# Production: https://your-serverless-api-url.execute-api.ap-southeast-1.amazonaws.com/production
NEXT_PUBLIC_API_URL=http://localhost:3000

# The URL of your Cloudflare R2 bucket (or any CDN) serving champion images.
# If you are serving images directly from the backend, this can be the same as the API URL.
# Local Development: http://localhost:3000
# Production: https://your-r2-public-url.com
NEXT_PUBLIC_R2_URL=http://localhost:3000
